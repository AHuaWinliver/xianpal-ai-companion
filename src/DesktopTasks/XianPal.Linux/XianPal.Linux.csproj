<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(LinuxCompat)' == 'true'">net8.0</TargetFramework>
    <AvaloniaVersion>12.1.5</AvaloniaVersion>
    <AvaloniaVersion Condition="'$(LinuxCompat)' == 'true'">11.3.22</AvaloniaVersion>
    <DefineConstants Condition="'$(LinuxCompat)' == 'true'">$(DefineConstants);XIANPAL_LINUX_COMPAT</DefineConstants>
    <AssemblyName>xianpal</AssemblyName>
    <RootNamespace>XianPal</RootNamespace>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../VERSION').Trim())</Version>
    <DefineConstants>$(DefineConstants);XIANPAL_LINUX</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <FontAssetsPath>$(MSBuildProjectDirectory)/../../../build/linux-resources/fonts</FontAssetsPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <Compile Include="../XianPal/ClaudeCliRunner.cs;../XianPal/ClaudeSettingsFile.cs;../XianPal/ClaudeTaskService.cs;../XianPal/ClaudeTaskStreamRenderer.cs;../XianPal/IntegrationPreferences.cs;../XianPal/ReminderService.cs;../XianPal/CompanionRolePresets.cs;../XianPal/PetCharacter.cs;../XianPal/PetBrain.cs;../XianPal/SectWorkshop.cs;../XianPal/DragGaitClock.cs;../XianPal/CharacterPackCatalog.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../XianPal/NativeTaskHooks.cs;../XianPal/VisibleTaskMonitor.cs;../XianPal/BackgroundTaskSupervisor.cs;../XianPal/UiLanguage.cs;../XianPal/TaskPresentation.cs" LinkBase="Shared" />
    <AvaloniaResource Include="$(FontAssetsPath)/*.otf;$(FontAssetsPath)/*.ttf" Link="Fonts/%(Filename)%(Extension)" />
    <Content Include="launch.sh;diagnose-linux.sh;install.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../LICENSE;../../../NOTICE;../../../ASSET-LICENSE.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireBundledFonts" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(FontAssetsPath)/NotoSansCJKsc-Regular.otf') Or !Exists('$(FontAssetsPath)/NotoColorEmoji.ttf')" Text="Prepare bundled fonts before building: python3 src/DesktopTasks/XianPal.Linux/fetch-fonts.py build/linux-resources/fonts" />
  </Target>
</Project>
